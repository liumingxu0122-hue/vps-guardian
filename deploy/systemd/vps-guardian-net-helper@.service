[Unit]
Description=VPS Guardian bounded network helper request
Requires=vps-guardian-net-helper.socket
After=vps-guardian-net-helper.socket

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/vps-guardian-net-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=25s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=/etc/vps-guardian-agent/identities /var/lib/vps-guardian-agent
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
ReadWritePaths=/var/lib/vps-guardian-net-helper /run/lock
SystemCallArchitectures=native
