# Public Compose configuration. Secrets are generated as files under ./secrets;
# never put passwords, tokens, or private keys in this file.
GUARDIAN_DOMAIN=guardian.example.com
GUARDIAN_AGENT_DOMAIN=agents.guardian.example.com
ACME_EMAIL=operator@example.com
GUARDIAN_BROWSER_ORIGIN=https://guardian.example.com
GUARDIAN_AGENT_BIND_ADDRESS=0.0.0.0
GUARDIAN_AGENT_PORT=8444
GUARDIAN_AGENT_GATEWAY_URL=https://agents.guardian.example.com:8444
GUARDIAN_AGENT_CERTIFICATE_TTL_HOURS=720
GUARDIAN_ENROLLMENT_ATTEMPTS_PER_10M=10
# One-command installation remains fail-closed until immutable release assets and
# their exact SHA-256 values are configured by a release operator.
GUARDIAN_ONE_COMMAND_INSTALL_ENABLED=false
GUARDIAN_AGENT_INSTALL_RELEASE_VERSION=v0.4.0-phase4-preview
GUARDIAN_AGENT_INSTALL_ASSETS_BASE_URL=https://github.com/liumingxu0122-hue/vps-guardian/releases/download
GUARDIAN_AGENT_INSTALLER_SHA256=
GUARDIAN_AGENT_BINARY_AMD64_SHA256=
GUARDIAN_AGENT_BINARY_ARM64_SHA256=
GUARDIAN_AGENT_CONTROLLER_CA_URL=https://downloads.example.com/controller-ca.crt
GUARDIAN_AGENT_CONTROLLER_CA_SHA256=
GUARDIAN_AGENT_CONTROLLER_PUBLIC_KEY_URL=https://downloads.example.com/controller-public-key.txt
GUARDIAN_AGENT_CONTROLLER_PUBLIC_KEY_SHA256=
GUARDIAN_METRIC_RETENTION_DAYS=7
GUARDIAN_SERVICE_RESULT_RETENTION_DAYS=30
GUARDIAN_MAX_METRIC_ROWS_PER_HOST=10080
GUARDIAN_MAX_RESULTS_PER_CHECK=43200
GUARDIAN_EXTERNAL_NOTIFICATIONS_ENABLED=false
# Browser sessions are opaque, server-side and independent from API JWT expiry.
GUARDIAN_SESSION_DEFAULT_IDLE_HOURS=12
GUARDIAN_SESSION_DEFAULT_ABSOLUTE_DAYS=7
GUARDIAN_SESSION_REMEMBER_IDLE_DAYS=7
GUARDIAN_SESSION_REMEMBER_ABSOLUTE_DAYS=30
GUARDIAN_SESSION_ACTIVITY_TOUCH_INTERVAL_SECONDS=300
GUARDIAN_SESSION_STEP_UP_MINUTES=10
GUARDIAN_DEPLOYMENT_STAGE=staging
GUARDIAN_PRODUCTION_DEPLOYED=false
GUARDIAN_OPERATIONS_GATE_DECISION=no_go_phase4_observation_pending
GUARDIAN_RELEASE_VERSION=0.4.0-phase4-preview
GUARDIAN_DEPLOYMENT_COMMIT=0000000000000000000000000000000000000000
GUARDIAN_SECRETS_DIR=./secrets
GUARDIAN_GATEWAY_PKI_DIR=./secrets/gateway-pki
VPS_GUARDIAN_SOURCE_COMMIT=0000000000000000000000000000000000000000
VPS_GUARDIAN_RELEASE_VERSION=0.4.0-phase4-preview
VPS_GUARDIAN_BUILD_TIME=1970-01-01T00:00:00Z
VPS_GUARDIAN_SOURCE_URL=https://github.com/liumingxu0122-hue/vps-guardian
VPS_GUARDIAN_LICENSE=Apache-2.0
VPS_GUARDIAN_DATABASE_IMAGE=vps-guardian-postgres:0.3.0-alpha.1
VPS_GUARDIAN_CONTROLLER_IMAGE=vps-guardian-controller:0.3.0-alpha.1
VPS_GUARDIAN_BACKUP_IMAGE=vps-guardian-controller:0.3.0-alpha.1
VPS_GUARDIAN_WEB_IMAGE=vps-guardian-web:0.3.0-alpha.1
RESTIC_REPOSITORY=
GUARDIAN_OFFSITE_SECRETS_DIR=
GUARDIAN_NOTIFICATION_SECRETS_DIR=
